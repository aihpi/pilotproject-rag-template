# =============================================================================
# Environment = secrets + infrastructure + which RAG config to load.
# Per-instance settings (models, collection, chunking, prompt, citations,
# starters) live in the YAML config — see config/default.yaml. Any variable
# below still OVERRIDES the YAML if set, but you rarely need to.
# =============================================================================

# Which RAG instance config to load (relative to apps/chainlit/).
# Default = the shipped example corpus (3 open-access papers) with all features
# on, so a fresh clone works immediately. Alternatives:
#   RAG_CONFIG=config/default.yaml   # neutral baseline, no features enabled
#   RAG_CONFIG=my-rag.yaml           # your own instance (gitignored)
#   RAG_CONFIG=examples/smb/rag.config.yaml  # documents on a Windows/SMB share
RAG_CONFIG=examples/papers/rag.config.yaml

# --- Windows / SMB share (optional) -----------------------------------------
# COMPOSE_FILE adds the override to EVERY docker compose call, so make up, check,
# reingest and logs all see the mount (Windows hosts separate with ';' not ':').
# COMPOSE_FILE=docker-compose.yml:docker-compose.smb.yml
# Only read by docker-compose.smb.yml. Ask your admin for a dedicated read-only
# account rather than using a personal login.
#
# The password must contain NO COMMA and NO `$`. Docker splits the mount options
# on commas, and Compose expands `$VAR` in the value. Neither produces a usable
# error; both look like a wrong password afterwards. The single quotes below are
# the net under that rule, keep them.
#
# This file is world-readable when it is created: `chmod 600 .env`. The password
# still reaches Docker's volume metadata in clear, which is why the account
# should be able to do nothing but read. See docs/adding-data.md.
# SMB_SHARE=//fileserver/documents
# SMB_USER=rag-reader
# SMB_PASSWORD='change-me'
#
# Where the share appears inside the containers. The default suits the bundled
# examples/smb config. Set it when your settings file reads the documents from
# somewhere else, which is the normal case for an out-of-template extension that
# brings its own config. The folder has to exist inside the container already.
# SMB_MOUNT_TARGET=/data/documents

# --- LiteLLM gateway (secrets) ----------------------------------------------
# Any OpenAI-compatible endpoint (LiteLLM proxy, OpenAI, a local gateway, ...).
# NOTE: model names are gateway-specific — see the comments in the YAML config.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-key

# --- Vector store ------------------------------------------------------------
# For a local (non-Docker) run. docker compose overrides this with the service
# name (http://qdrant:6333), so you never have to switch it back and forth.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- docker compose host ports ----------------------------------------------
# Only the HOST side; container ports never change. Bump these if something else
# already listens there (another project's Qdrant/Postgres, a dev server on 8000).
# APP_PORT=8000
# QDRANT_PORT=6333
# POSTGRES_PORT=5432

# --- Native Chainlit persistence + auth -------------------------------------
# Host `postgres` is the docker-compose service name and only resolves INSIDE the
# compose network. Running the app directly on your machine? Use localhost:
#   DATABASE_URL=postgresql://chainlit:chainlit@localhost:5432/chainlit
# docker compose ignores this variable on purpose (it hardcodes the service name),
# so switching it does not break the Docker path. To point compose at an external
# database, set DOCKER_DATABASE_URL instead.
DATABASE_URL=postgresql://chainlit:chainlit@postgres:5432/chainlit
CHAINLIT_AUTH_SECRET=change-me-with-a-long-random-string
CHAINLIT_INIT_DB=true

# GitHub OAuth - Create app at https://github.com/settings/developers
OAUTH_GITHUB_CLIENT_ID=Iv1.abc123def456
OAUTH_GITHUB_CLIENT_SECRET=0123456789abcdef0123456789abcdef01234567

# Admin fallback authentication (optional, for local development without OAuth)
CHAINLIT_AUTH_USERNAME=admin
CHAINLIT_AUTH_PASSWORD=admin

# --- Chat history persistence + export --------------------------------------
# Chat history database. This value is for running the app directly on your machine.
# Under Docker it is overridden to a path on a named volume, because this folder is
# shared with your computer and SQLite is not safe there: Docker Desktop only
# imitates the file locking SQLite needs, and an interrupted write can leave you with
# "database disk image is malformed". An existing history is copied over once,
# automatically. See docs/troubleshooting.md.
CHAT_DB_PATH=./.chainlit/chat_history.sqlite3
#
# Where Docker keeps it. Leave this alone unless you have a reason: the default is a
# Docker volume, which is the safe place for it. Worth setting on Linux, where the
# shared folder is an ordinary filesystem and SQLite is safe there, so you may prefer
# the file next to the project where your usual backups will pick it up:
# DOCKER_CHAT_DB_PATH=/app/.chainlit/chat_history.sqlite3
CHAT_EXPORT_DIR=./.files/chat_exports

# --- Watching the documents folder -------------------------------------------
# The app watches your document folders and indexes new, changed and deleted files
# by itself, so putting a file into the folder is enough. This is ON by default and
# these lines only exist to switch it off, which means an .env you copied earlier
# needs no editing to get the feature.
#
# Uncomment to go back to indexing only when you run it yourself:
# DOCUMENT_WATCH=false
#
# Changes normally arrive the moment they happen. This only sets how often the app
# double-checks anyway, in seconds, to catch anything it was not told about.
# DOCUMENT_WATCH_INTERVAL=5
#
# Ignore files changed in the last N seconds, so a large file still being copied in
# is not read half-finished.
# DOCUMENT_WATCH_SETTLE=5

# --- Docker auto-ingestion ---------------------------------------------------
INGEST_RECREATE=false
INGEST_BATCH_SIZE=256
INGEST_MAX_BATCH_CHARS=20000
# Rewrites the JSON folder of every PDF source that declares docling_json_dir, so
# one YAML can serve a container path and a local path. Leave it unset unless your
# compose file mounts that folder somewhere else. The folder's parent must exist
# where the ingest runs; a missing parent means nothing is converted.
# INGEST_DOCLING_JSON_DIR=/data/data_docling_json_ocr

# --- Optional overrides (normally set in the YAML config instead) -----------
# CHAT_MODEL=gpt-oss-120b
# EMBED_MODEL=octen-embedding-8b
# FALLBACK_CHAT_MODEL=
# QDRANT_COLLECTION=documents
# TOP_K=5
# SCORE_THRESHOLD=0.0
# STREAMING_ENABLED=false
# MAX_TOOL_CALL_ROUNDS=12

